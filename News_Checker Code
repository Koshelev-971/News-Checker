        print("информацию, совпадающую с вашим запросом.")
    else:
        max_score = results[0]['score']


        if max_score > 40:
            print(f"ВЕРДИКТ: ИНФОРМАЦИЯ ПОДТВЕРЖДЕНА (Схожесть: {max_score:.1f}%)")
        else:
            print(f"ВЕРДИКТ: ТЕМА УПОМИНАЕТСЯ, НО ЕСТЬ ОТЛИЧИЯ ({max_score:.1f}%)")

        print("\nНАЙДЕННЫЕ ОФИЦИАЛЬНЫЕ ИСТОЧНИКИ:")
        print("-" * 60)
        
        for i, res in enumerate(results, 1):
            print(f"[{i}] ИСТОЧНИК: {res['url']}")
