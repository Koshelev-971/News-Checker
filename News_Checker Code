import streamlit as st
import trafilatura
from duckduckgo_search import DDGS
from sentence_transformers import SentenceTransformer, util
import time
import hashlib
import re


# ==========================================
# ЧАСТЬ 1: ЛОГИКА
# ==========================================
class NewsAnalyzer:
    def __init__(self):
        self.model = SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2')
        self.sites = ["tass.ru", "rbc.ru", "ria.ru", "interfax.ru", "kommersant.ru", "lenta.ru", "rt.com"]

    def extract_keywords(self, text):
        text = re.sub(r'[^\w\s]', ' ', text)
        words = text.split()
        return " ".join(words[:12])

    def get_text(self, url):
        try:
            downloaded = trafilatura.fetch_url(url, timeout=7)
            if downloaded:
                result = trafilatura.extract(downloaded)
                return result if result and len(result) > 150 else None
        except:
            return None
        return None

    def find_best_match(self, user_text):
        keywords = self.extract_keywords(user_text)
        all_found_links = []

        search_status = st.empty()

        with DDGS() as ddgs:
            for site in self.sites:
                search_status.info(f"Поиск по источнику: {site}...")
                try:
                    query = f"{keywords} site:{site}"
                    results = list(ddgs.text(query, region='ru-ru', max_results=3))
                    for r in results:
                        all_found_links.append(r['href'])
                except:
                    continue
                time.sleep(0.4)

        if not all_found_links:
            search_status.warning("На проверенных СМИ ничего нет. Ищу по всему интернету...")
            try:
                with DDGS() as ddgs:
                    results = list(ddgs.text(keywords, region='ru-ru', max_results=8))
                    all_found_links = [r['href'] for r in results]
            except:
                pass

        if not all_found_links:
            search_status.empty()
            return None

        search_status.info(f"Найдено {len(all_found_links)} ссылок. Начинаю ИИ-анализ...")

        user_embedding = self.model.encode(user_text, convert_to_tensor=True)
        results_list = []

        progress_bar = st.progress(0)
        for i, url in enumerate(all_found_links):
            progress_bar.progress((i + 1) / len(all_found_links))
            source_text = self.get_text(url)

            if not source_text: continue

            source_embedding = self.model.encode(source_text, convert_to_tensor=True)
            similarity = util.cos_sim(user_embedding, source_embedding).item()
            results_list.append({"url": url, "score": similarity})

        search_status.empty()
        progress_bar.empty()

        if not results_list: return None

        return max(results_list, key=lambda x: x['score'])

# ==========================================
# ЧАСТЬ 2: ЗАЩИТА
# ==========================================
class SecurityLayer:
    def __init__(self):
        self.cache = {}
        self.request_history = []
        self.rpm_limit = 3

    def check_rate_limit(self):
        now = time.time()
        self.request_history = [t for t in self.request_history if now - t < 60]
        if len(self.request_history) >= self.rpm_limit:
            return False
        self.request_history.append(now)
        return True

    def get_cache(self, text):
        h = hashlib.md5(text.encode()).hexdigest()
        return self.cache.get(h)

    def set_cache(self, text, result):
        if len(self.cache) >= 50: self.cache.clear()
        h = hashlib.md5(text.encode()).hexdigest()
        self.cache[h] = result


# ==========================================
# ЧАСТЬ 3: ИНТЕРФЕЙС
# ==========================================
st.set_page_config(page_title="News Checker", page_icon="📰")

if 'logic' not in st.session_state:
    with st.spinner("Первичная настройка системы..."):
        st.session_state.brain_v3 = NewsAnalyzer()
        st.session_state.guard_v3 = SecurityLayer()

st.title("📰 News Checker")
st.write("Введите текст новости для проверки подлинности:")

user_input = st.text_area(" ", height=200, key="main_input")

if st.button("Проверить подлинность"):
    if len(user_input) < 20:
        st.error("Текст слишком короткий!")

    elif not st.session_state.guard_v3.check_rate_limit():
        st.warning("⚠️ Слишком много запросов. Подождите 60 секунд.")

    else:
        cached = st.session_state.guard_v3.get_cache(user_input)

        if cached:
            st.info("Результат найден в кэше.")
            result = cached
        else:
            with st.spinner("ИИ анализирует официальные СМИ..."):
                result = st.session_state.brain_v3.find_best_match(user_input)
                if result and "error" not in result:
                    st.session_state.guard_v3.set_cache(user_input, result)

        if result:
            score = result.get('score', 0)
            url = result.get('url', '')
            if score >= 0.7:
                st.success(f"### ПОДТВЕРЖДЕНО ({score:.1%})")
                st.write(f"**Источник:** {url}")
            elif score >= 0.4:
                st.warning(f"### ПОХОЖЕ НА ПРАВДУ ({score:.1%})")
                st.write(f"Источник: {url}")
            else:
                st.error("Точных совпадений в базе СМИ не найдено.")
        else:
            st.error("Новость не найдена в базе доверенных СМИ.")
